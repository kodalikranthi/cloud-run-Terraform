# Copy this file to terraform.tfvars and update the values

# Required variables
project_id = "your-gcp-project-id"
region     = "australia-southeast2"  # Melbourne region
environment = "dev"

# Network Configuration
existing_vpc_network = "default"
existing_vpc_subnet  = "default"
vpc_access_connector_name = "vpc-connector"  # Set to "" if not using VPC connector
vpc_access_connector_region = "australia-southeast2"

# Load Balancer Configuration
load_balancer_network = "default"
load_balancer_subnet  = "default"
# load_balancer_ip_address = "10.0.0.100"  # Optional: specify existing IP

# Cloud Run Services Configuration
cloud_run_services = {
  "app" = {
    name         = "my-app"
    image_name   = "app"
    image_tag    = "latest"
    cpu_limit    = "1"
    memory_limit = "512Mi"
    min_instances = 1
    max_instances = 10
    environment_vars = {
      "ENVIRONMENT" = "dev"
      "LOG_LEVEL"   = "info"
      "PORT"        = "8080"
      "DEBUG"       = "false"
    }
    secret_names = ["DATABASE_URL", "API_KEY", "JWT_SECRET"]
  }
  "api" = {
    name         = "my-api"
    image_name   = "api"
    image_tag    = "v1.0"
    cpu_limit    = "2"
    memory_limit = "1Gi"
    min_instances = 1
    max_instances = 20
    environment_vars = {
      "ENVIRONMENT" = "dev"
      "API_VERSION" = "v1"
      "PORT"        = "8080"
    }
    secret_names = ["API_SECRET", "DB_PASSWORD"]
  }
  # Add more services as needed
  # "worker" = {
  #   name         = "background-worker"
  #   image_name   = "worker"
  #   image_tag    = "latest"
  #   cpu_limit    = "1"
  #   memory_limit = "512Mi"
  #   min_instances = 1
  #   max_instances = 5
  #   environment_vars = {
  #     "ENVIRONMENT" = "dev"
  #     "WORKER_TYPE" = "background"
  #   }
  #   secret_names = ["REDIS_URL", "WORKER_SECRET"]
  # }
}

# Secrets Configuration for Secret Manager
secrets = {
  "DATABASE_URL" = "postgresql://user:password@localhost:5432/dbname"
  "API_KEY"      = "your-api-key-here"
  "JWT_SECRET"   = "your-jwt-secret-here"
  "API_SECRET"   = "your-api-secret-here"
  "DB_PASSWORD"  = "your-db-password-here"
  "REDIS_URL"    = "redis://localhost:6379"
  # Add more secrets as needed
  # "WORKER_SECRET" = "your-worker-secret"
  # "EXTERNAL_API_KEY" = "your-external-api-key"
}

# SSL Certificates Configuration (optional - set to {} if not using SSL)
ssl_certificates = {
  "main" = {
    domains = ["your-domain.com", "www.your-domain.com"]
  }
  "api" = {
    domains = ["api.your-domain.com", "api-staging.your-domain.com"]
  }
  # Add more certificates as needed
  # "admin" = {
  #   domains = ["admin.your-domain.com"]
  # }
}

# Spanner Configuration (optional)
spanner_instances = {
  "main" = {
    instance_id = "my-spanner-instance"
    database_id = "my-database"
  }
  "analytics" = {
    instance_id = "analytics-spanner-instance"
    database_id = "analytics-database"
  }
  # Add more Spanner instances as needed
  # "audit" = {
  #   instance_id = "audit-spanner-instance"
  #   database_id = "audit-database"
  # }
}

# Artifact Registry Configuration
artifact_registries = {
  "main" = {
    repository_id = "cloud-run-repo"
    description   = "Docker repository for Cloud Run services"
    format        = "DOCKER"
    labels = {
      service = "cloud-run"
      team    = "platform"
    }
  }
  "npm" = {
    repository_id = "npm-repo"
    description   = "NPM repository for Node.js packages"
    format        = "NPM"
    labels = {
      service = "npm-packages"
      team    = "platform"
    }
  }
  # Add more repositories as needed
  # "maven" = {
  #   repository_id = "maven-repo"
  #   description   = "Maven repository for Java packages"
  #   format        = "MAVEN"
  #   labels = {
  #     service = "maven-packages"
  #     team    = "platform"
  #   }
  # }
}

# KMS Configuration
kms_key_rings = {
  "main" = {
    location = "australia-southeast2"
  }
  "backup" = {
    location = "australia-southeast1"
  }
  # Add more key rings as needed
  # "audit" = {
  #   location = "australia-southeast2"
  # }
}

kms_keys = {
  "main" = {
    key_ring_name = "main"
    rotation_period = "7776000s" # 90 days
  }
  "backup" = {
    key_ring_name = "backup"
    rotation_period = "15552000s" # 180 days
  }
  # Add more keys as needed
  # "audit" = {
  #   key_ring_name = "main"
  #   rotation_period = "31536000s" # 365 days
  # }
}

